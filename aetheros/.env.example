# ─── AetherOS Environment Configuration ─────────────────────────────────────

# Application
NODE_ENV=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
API_URL=http://api:8000

# Database
DATABASE_URL=postgresql+asyncpg://aetheros:aetheros@postgres:5432/aetheros
POSTGRES_USER=aetheros
POSTGRES_PASSWORD=aetheros
POSTGRES_DB=aetheros
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Docker
COMPOSE_PROJECT_NAME=aetheros

# Health
HEALTH_CHECK_INTERVAL=30
